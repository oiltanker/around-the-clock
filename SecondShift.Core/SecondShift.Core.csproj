    <Reference Include="Timberborn.EntitySystem"><HintPath>$(GameDir)\Timberborn.EntitySystem.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.Persistence"><HintPath>$(GameDir)\Timberborn.Persistence.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.TemplateInstantiation"><HintPath>$(GameDir)\Timberborn.TemplateInstantiation.dll</HintPath><Private>false</Private></Reference>
