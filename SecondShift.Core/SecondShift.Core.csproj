<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>SecondShift.Core</AssemblyName>
    <LangVersion>10</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Bindito.Core"><HintPath>$(GameDir)\Bindito.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Bindito.Unity"><HintPath>$(GameDir)\Bindito.Unity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Timberborn.BaseComponentSystem"><HintPath>$(GameDir)\Timberborn.BaseComponentSystem.dll</HintPath><Private>false</Private></Reference>
